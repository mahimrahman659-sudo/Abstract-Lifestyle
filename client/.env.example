# ---------------------------------------------------------------------------
# Abstract Lifestyle — Next.js client (.env.example)
# Copy to .env.local and adjust for your machine.
# ---------------------------------------------------------------------------

# Base URL of the Express API server. Used by the Next.js rewrites in
# next.config.ts to proxy same-origin /api/* requests (cookie auth).
# Default when unset: http://localhost:4000
API_URL=http://localhost:4000

# Public origin of the storefront — used for metadata (metadataBase, Open Graph),
# robots.txt and sitemap.xml. Default when unset: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary cloud name (PUBLIC — it appears in every image URL). Used only to
# restrict next/image remotePatterns to your cloud. The API key/secret live in
# the server env only and are never exposed to the client.
CLOUDINARY_CLOUD_NAME=

# Google Identity Services client id (PUBLIC by design — it configures the
# hosted Google sign-in button). The server holds the same id for ID-token
# verification; no Google secret ever reaches the client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
