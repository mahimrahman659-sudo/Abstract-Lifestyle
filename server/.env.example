# ---------------------------------------------------------------------------
# Abstract Lifestyle — API server (.env.example)
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# MongoDB connection string. Checkout, cancellation and variant/product deletion
# use multi-document transactions, so the API requires a replica set or sharded
# cluster (MongoDB Atlas is a replica set). A standalone mongod is rejected at
# startup with a diagnostic.
#
# Local single-node replica set:
#   mongod --replSet rs0 --dbpath ./data --port 27017
#   mongosh --eval "rs.initiate({_id:'rs0',members:[{_id:0,host:'127.0.0.1:27017'}]})"
MONGODB_URI=mongodb://127.0.0.1:27017/abstract_lifestyle?replicaSet=rs0&directConnection=true

# Secret used to sign JWTs (minimum 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Exact origin of the Next.js client (used for CORS, credentials included)
CLIENT_ORIGIN=http://localhost:3000

# Flat shipping fee in poisha (1 BDT = 100 poisha). 0 = free shipping
SHIPPING_FEE=0

# Seed admin credentials (consumed by the seed script)
# In production the API refuses to start when ADMIN_PASSWORD is weak:
# use 12+ characters and avoid "change-me" / "password" / the admin email.
ADMIN_EMAIL=admin@abstractlifestyle.com
ADMIN_PASSWORD=change-me-admin-password

# Express "trust proxy" setting. Leave empty in development; behind one reverse
# proxy (nginx, Caddy, a PaaS router) set 1 so rate limiting and secure cookies
# see the real client IP / protocol. REQUIRED in production — the API refuses to
# start when NODE_ENV=production and this is unset.
TRUST_PROXY=

# Rate limits (requests per minute). The global limiter is per IP; the checkout
# and upload limiters are keyed per authenticated user (IP fallback for guests).
API_RATE_LIMIT_PER_MIN=300
ORDER_RATE_LIMIT_PER_MIN=30
UPLOAD_RATE_LIMIT_PER_MIN=20

# Cloudinary (product image storage). Required in production — the API refuses
# to start when any of these is missing. Optional in development; uploads fail
# with "Image storage is not configured" when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Identity Services client id (public). Used server-side to verify
# Google ID tokens (audience check). REQUIRED in production. Optional in
# development — POST /auth/google fails with a generic 401 when unset.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Manual MFS payments (bKash, Nagad, Rocket) — Phase 2
# ---------------------------------------------------------------------------
# Every provider is DISABLED by default. Enable only after the owner has
# confirmed an authorized receiving account and the approved transfer type
# (Send Money vs Merchant/Payment). Never commit real numbers.
#
# The receiving number is returned to the storefront only when BOTH the
# provider is enabled and the number validates. bKash/Nagad accept 11-digit
# Bangladeshi mobile accounts; Rocket also accepts its 12-digit account form
# (11-digit mobile + check digit). Invalid enabled config refuses API startup.
# Enabling any provider also requires payment_trxid_unique to exist and match
# its exact definition; the API fails startup/health and disables implicit index
# creation. Run PAYMENT_INDEX_MIGRATION_PLAN.md before enabling a provider.
BKASH_PAYMENT_ENABLED=false
BKASH_PAYMENT_NUMBER=
# Optional provider-specific instructions, separated by '|'. Leave empty for
# safe defaults (the defaults do not claim that personal Send Money is approved).
BKASH_PAYMENT_INSTRUCTIONS=

NAGAD_PAYMENT_ENABLED=false
NAGAD_PAYMENT_NUMBER=
NAGAD_PAYMENT_INSTRUCTIONS=

ROCKET_PAYMENT_ENABLED=false
ROCKET_PAYMENT_NUMBER=
ROCKET_PAYMENT_INSTRUCTIONS=

# Conservative TrxID bounds after normalization (trim/whitespace removal/uppercase).
# Provider formats are not formally documented, so these are configuration.
MFS_TRX_ID_MIN_LENGTH=6
MFS_TRX_ID_MAX_LENGTH=32

# Reservation expiry is NOT automated. 0 = no policy. A future owner-approved
# reconciliation job would read this; nothing in the API cancels orders today.
MANUAL_PAYMENT_EXPIRY_MINUTES=0

# Customer Activity Center (Phase 1A) — ships DISABLED. While false, POST
# /api/events answers 204 and persists nothing; no server-side events are
# written. Enabling requires owner approval (plan Phase 4).
ACTIVITY_EVENTS_ENABLED=false
# Per-identity (or per-IP) event ingest budget, requests per minute.
ACTIVITY_EVENTS_RATE_LIMIT_PER_MIN=60

# Disposable index verification helper (never production):
#   MONGODB_TEST_MODE=disposable
#   MONGODB_TEST_URI=mongodb://127.0.0.1:27018/p2_payments_test?replicaSet=rs0&directConnection=true
#   npm run payment-index -- --apply|--status|--rollback

# DEV-ONLY automated-test seam for the Google ID-token verifier (lets tests
# post fake credentials to POST /auth/google). Must never be set — the API
# refuses to start when NODE_ENV=production and this is present.
# GOOGLE_AUTH_TEST_SEAM=

# Destructive integration tests only: use a disposable local replica set.
# Both values are mandatory; no fallback to MONGODB_URI or remote opt-in exists.
# MONGODB_TEST_MODE=disposable
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018/p0_integrity_test?replicaSet=rs0&directConnection=true
# MONGODB_STANDALONE_URI=mongodb://127.0.0.1:27019/p0_standalone_test
