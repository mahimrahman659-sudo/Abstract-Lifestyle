# ---------------------------------------------------------------------------
# Abstract Lifestyle — API server (.env.example)
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# MongoDB connection string (used from Task 2 onward)
MONGODB_URI=mongodb://127.0.0.1:27017/abstract_lifestyle

# Secret used to sign JWTs (minimum 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Exact origin of the Next.js client (used for CORS, credentials included)
CLIENT_ORIGIN=http://localhost:3000

# Flat shipping fee in poisha (1 BDT = 100 poisha). 0 = free shipping
SHIPPING_FEE=0

# Seed admin credentials (consumed by the seed script)
# In production the API refuses to start when ADMIN_PASSWORD is weak:
# use 12+ characters and avoid "change-me" / "password" / the admin email.
ADMIN_EMAIL=admin@abstractlifestyle.com
ADMIN_PASSWORD=change-me-admin-password

# Express "trust proxy" setting. Leave empty locally; behind one reverse proxy
# (nginx, Caddy, a PaaS router) set 1 so rate limiting and secure cookies see
# the real client IP / protocol.
TRUST_PROXY=
