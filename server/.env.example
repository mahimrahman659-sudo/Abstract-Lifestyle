# ---------------------------------------------------------------------------
# Abstract Lifestyle — API server (.env.example)
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# MongoDB connection string (used from Task 2 onward)
MONGODB_URI=mongodb://127.0.0.1:27017/abstract_lifestyle

# Secret used to sign JWTs (minimum 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Exact origin of the Next.js client (used for CORS, credentials included)
CLIENT_ORIGIN=http://localhost:3000

# Flat shipping fee in poisha (1 BDT = 100 poisha). 0 = free shipping
SHIPPING_FEE=0

# Seed admin credentials (consumed by the seed script)
# In production the API refuses to start when ADMIN_PASSWORD is weak:
# use 12+ characters and avoid "change-me" / "password" / the admin email.
ADMIN_EMAIL=admin@abstractlifestyle.com
ADMIN_PASSWORD=change-me-admin-password

# Express "trust proxy" setting. Leave empty in development; behind one reverse
# proxy (nginx, Caddy, a PaaS router) set 1 so rate limiting and secure cookies
# see the real client IP / protocol. REQUIRED in production — the API refuses to
# start when NODE_ENV=production and this is unset.
TRUST_PROXY=

# Rate limits (requests per minute). The global limiter is per IP; the checkout
# and upload limiters are keyed per authenticated user (IP fallback for guests).
API_RATE_LIMIT_PER_MIN=300
ORDER_RATE_LIMIT_PER_MIN=30
UPLOAD_RATE_LIMIT_PER_MIN=20

# Cloudinary (product image storage). Required in production — the API refuses
# to start when any of these is missing. Optional in development; uploads fail
# with "Image storage is not configured" when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Identity Services client id (public). Used server-side to verify
# Google ID tokens (audience check). REQUIRED in production. Optional in
# development — POST /auth/google fails with a generic 401 when unset.
GOOGLE_CLIENT_ID=

# DEV-ONLY automated-test seam for the Google ID-token verifier (lets tests
# post fake credentials to POST /auth/google). Must never be set — the API
# refuses to start when NODE_ENV=production and this is present.
# GOOGLE_AUTH_TEST_SEAM=
